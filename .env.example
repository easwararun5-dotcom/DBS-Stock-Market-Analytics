# DBS Stock Market Analytics — Dual Database Environment Configuration
# Copy this file to .env and adjust values for your environment.
# .env is git-ignored and must never be committed.

# Connection A: PostgreSQL — Relational Database (stock_market_db)
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_DB=stock_market_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here

# Connection B: TimescaleDB — Time-Series Database (stock_timescale_db)
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5434
TIMESCALE_DB=stock_timescale_db
TIMESCALE_USER=postgres
TIMESCALE_PASSWORD=your_timescale_password_here

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here

# Frontend API URL (used during development)
VITE_API_BASE_URL=http://localhost:8000


